# Add this location inside your existing HTTPS server{} block.
# Configure your certificate and server_name in that existing block.
location /docling/ {
    client_max_body_size 50m;
    proxy_pass http://127.0.0.1:8876/;
    proxy_set_header Host 127.0.0.1:8876;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Connection "";
    proxy_http_version 1.1;
    proxy_connect_timeout 10s;
    proxy_read_timeout 270s;
    proxy_send_timeout 270s;
    proxy_buffering off;
    proxy_request_buffering off;
}
